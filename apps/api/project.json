{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "cwd": "apps/api",
        "command": "CGO_ENABLED=0 go build -trimpath -o ../../dist/apps/api/api ./cmd/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "cwd": "apps/api", "command": "go run ./cmd/api" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "cwd": "apps/api", "command": "go test -race ./..." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/api",
        "command": "test -z \"$(gofmt -l .)\" && go vet ./..."
      }
    }
  }
}
