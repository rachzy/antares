# Copy to .env for local dev; `npm run dev:api` and `make dev-api` load it.

# Server
# Listen address (host:port).
ANTARES_ADDR=:8080
# SQLite file for targets, caches, jobs and subscriptions; the binary defaults to antares.db in the working directory, the dev scripts to .data/api/antares.db when unset.
# ANTARES_DB_PATH=antares.db

# Upstreams (plaintext gRPC: private network only)
# Shaula (feature extraction) gRPC address.
ANTARES_SHAULA_ADDR=127.0.0.1:50051
# Fang (classifier) gRPC address.
ANTARES_FANG_ADDR=127.0.0.1:50052

# Queue and jobs
# Extractions running at once; must be >= 1, keep at or below Shaula's worker pool (4).
ANTARES_MAX_ACTIVE=2
# Waiting jobs allowed before new work is refused with 503; must be >= 0 (0 = reject when busy).
ANTARES_MAX_QUEUE=50
# A waiting job is kept only if a client was connected or polled within this duration; must be > 0.
ANTARES_PROMOTION_GRACE=30s
# Hard limit for one job (Go duration); must be > 0.
ANTARES_JOB_TIMEOUT=30m
# A job with no progress event for this long is failed (Go duration); must be > 0.
ANTARES_STALL_TIMEOUT=5m

# Retention
# How long a subscription token keeps working (Go duration, 168h = 7 days); must be > 0.
ANTARES_TOKEN_RETENTION=168h
# TESS cache entries expire after this (Go duration, 720h = 30 days); Kepler and K2 never expire; must be > 0.
ANTARES_TESS_TTL=720h

# Streaming
# Events kept per job for replay; must be >= 1.
ANTARES_RING_SIZE=500
# Per-WebSocket send buffer in frames; a connection that falls behind is dropped; must be >= 1.
ANTARES_CONN_BUFFER=64
# Progress events are batched into one frame per this interval (Go duration); must be > 0.
ANTARES_COALESCE_INTERVAL=100ms

# CORS
# Comma-separated origins allowed by CORS and WebSocket origin checks (empty = none), e.g. http://localhost:4200,http://127.0.0.1:4200
ANTARES_ALLOWED_ORIGINS=
