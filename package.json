{
  "name": "@antares/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "setup": "npm install && npm run install:py && npm run proto:generate",
    "install:py": "nx run-many -t install -p shaula fang",
    "proto:generate": "nx run proto:generate",
    "dev": "SHAULA_LIGHTCURVE_CACHE=\"$PWD/.data/shaula/lightkurve\" FANG_ARTIFACT_DIR=\"$PWD/.data/fang/models\" nx run-many -t serve -p www shaula fang",
    "dev:www": "nx serve www",
    "dev:shaula": "SHAULA_LIGHTCURVE_CACHE=\"$PWD/.data/shaula/lightkurve\" nx serve shaula",
    "dev:fang": "FANG_ARTIFACT_DIR=\"$PWD/.data/fang/models\" nx serve fang",
    "start": "npm run dev",
    "start:prod": "make up",
    "stop:prod": "make down",
    "build": "nx build www",
    "build:docker": "nx run-many -t docker-build -p www shaula fang",
    "lint": "nx run-many -t lint -p www shaula fang",
    "lint:fix": "nx run-many -t lint -p www shaula fang -- --fix",
    "format": "nx format:write && nx run-many -t format -p shaula fang",
    "format:check": "nx format:check && nx run-many -t format-check -p shaula fang",
    "test": "nx run-many -t test -p www shaula fang",
    "ci": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~22.1.0",
    "@spartan-ng/cli": "^1.4.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~22.1.0",
    "nx": "23.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@spartan-ng/brain": "^1.4.1",
    "aladin-lite": "^3.9.2-beta",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0"
  }
}
